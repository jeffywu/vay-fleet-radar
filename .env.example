# Local application and database settings. Replace values in .env; never commit .env.
APP_PORT=3000
POSTGRES_DB=fleet_radar
POSTGRES_USER=fleet_radar
POSTGRES_PASSWORD=replace-local-password
DATABASE_URL=postgresql://fleet_radar:replace-local-password@postgres:5432/fleet_radar

# Public browser token (pk.*) and server-only Directions token. Empty values enable degraded modes.
VITE_MAPBOX_ACCESS_TOKEN=pk.eyJ1IjoiamVmZnl3dSIsImEiOiJjbXRieGhpcXIwZmJ1Mnltdmt4b3hkaWNnIn0.athLNGnkdr5PP-OuSBYFQw
MAPBOX_DIRECTIONS_ACCESS_TOKEN=pk.eyJ1IjoiamVmZnl3dSIsImEiOiJjbXRieGhpcXIwZmJ1Mnltdmt4b3hkaWNnIn0.athLNGnkdr5PP-OuSBYFQw
VITE_API_PROXY_TARGET=http://127.0.0.1:3000

STALE_AFTER_SECONDS=10
DISPATCH_TARGET_ACTIVE=10
DISPATCH_INTERVAL_MS=5000
DISPATCH_MAX_PER_CYCLE=2
SSE_RETENTION_ROWS=10000
SSE_RETENTION_HOURS=24
LOG_LEVEL=info
